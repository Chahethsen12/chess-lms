# ===========================================
# Chess Mastery LMS - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chess_lms?schema=public"

# Authentication
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# AI Providers (at least one required for AI Coach)
# The system tries providers in order until one succeeds:
# 1. Gemini (primary) → 2. Claude → 3. GPT-4o → 4. Grok → 5. Local fallback
# Get your API keys from:
# - Gemini: https://makersuite.google.com/app/apikey
# - Anthropic: https://console.anthropic.com/
# - OpenAI: https://platform.openai.com/api-keys
# - xAI: https://x.ai/api
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
XAI_API_KEY=""

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api

# ===========================================
# Production Environment Notes
# ===========================================
# For production deployment, ensure:
# 1. JWT_SECRET is a cryptographically secure random string (32+ chars)
# 2. DATABASE_URL points to your production PostgreSQL instance
# 3. At least one AI provider API key is configured
# 4. CORS_ORIGIN matches your production frontend domain
# 5. NODE_ENV=production
#
# Railway/Render: Set these as environment variables in the dashboard
# Vercel: Set VITE_API_URL to your production API URL
